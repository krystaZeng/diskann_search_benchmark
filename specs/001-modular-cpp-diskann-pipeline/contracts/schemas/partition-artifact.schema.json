{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://diskann-repro.local/contracts/v1/partition-artifact.schema.json",
  "title": "PartitionArtifact Metadata v1",
  "description": "One aggregate Partition stage output containing all Partition records and payload references; individual records are not separate ArtifactRefs.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "canonicalization",
    "artifact_type",
    "format_version",
    "dataset",
    "id_space",
    "structural",
    "capabilities",
    "source_artifacts",
    "payloads",
    "aggregate_checksum"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "canonicalization": {"const": "diskann-artifact-c14n-v1"},
    "artifact_type": {"const": "partition"},
    "format_version": {"const": "partition-artifact/v1"},
    "dataset": {"$ref": "common.schema.json#/$defs/datasetIdentity"},
    "id_space": {"const": "local"},
    "structural": {
      "type": "object",
      "additionalProperties": false,
      "required": ["partition_count", "partitions"],
      "properties": {
        "partition_count": {"type": "integer", "minimum": 1, "maximum": 4294967296},
        "partitions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "partition_id",
              "local_node_count",
              "shard_vectors_role",
              "local_to_global_map_role"
            ],
            "properties": {
              "partition_id": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4294967295,
                "description": "Explicit selector passed with the aggregate PartitionArtifact to one Local Build invocation."
              },
              "local_node_count": {"type": "integer", "minimum": 1, "maximum": 4294967296},
              "shard_vectors_role": {"$ref": "common.schema.json#/$defs/stableId"},
              "local_to_global_map_role": {"$ref": "common.schema.json#/$defs/stableId"}
            }
          }
        }
      }
    },
    "capabilities": {
      "allOf": [
        {"$ref": "common.schema.json#/$defs/capabilityArray"},
        {"contains": {"const": "partition.complete_local_to_global_map/v1"}}
      ]
    },
    "source_artifacts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {"$ref": "common.schema.json#/$defs/sourceArtifactIdentity"}
    },
    "payloads": {
      "type": "array",
      "minItems": 2,
      "items": {"$ref": "common.schema.json#/$defs/payloadRef"}
    },
    "aggregate_checksum": {"$ref": "common.schema.json#/$defs/sha256"}
  }
}
