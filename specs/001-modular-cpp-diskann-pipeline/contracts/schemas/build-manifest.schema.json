{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://diskann-repro.local/contracts/v1/build-manifest.schema.json",
  "title": "BuildManifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_version",
    "run_id",
    "stage",
    "implementation",
    "source",
    "toolchain",
    "dataset",
    "parameters",
    "resource_budget",
    "input_artifacts",
    "output_artifacts",
    "status",
    "started_at",
    "ended_at"
  ],
  "properties": {
    "manifest_version": {"const": "1.0.0"},
    "run_id": {"$ref": "common.schema.json#/$defs/stableId"},
    "stage": {
      "enum": ["build", "partition", "local_build", "merge", "validate", "evaluate"]
    },
    "implementation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["implementation_id", "implementation_version"],
      "properties": {
        "implementation_id": {"$ref": "common.schema.json#/$defs/stableId"},
        "implementation_version": {"$ref": "common.schema.json#/$defs/version"}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "branch", "commit", "dirty_worktree"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "branch": {"type": "string", "minLength": 1},
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "dirty_worktree": {"type": "boolean"},
        "dirty_source_checksum": {"$ref": "common.schema.json#/$defs/sha256"}
      },
      "allOf": [
        {
          "if": {"properties": {"dirty_worktree": {"const": true}}},
          "then": {"required": ["dirty_source_checksum"]}
        }
      ]
    },
    "toolchain": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "os",
        "compiler_path",
        "compiler_version",
        "cmake_version",
        "generator",
        "build_type",
        "cmake_definitions",
        "compile_commands",
        "link_commands"
      ],
      "properties": {
        "os": {"type": "string", "minLength": 1},
        "compiler_path": {"type": "string", "minLength": 1},
        "compiler_version": {"type": "string", "minLength": 1},
        "cmake_version": {"type": "string", "minLength": 1},
        "generator": {"type": "string", "minLength": 1},
        "build_type": {"type": "string", "minLength": 1},
        "cmake_definitions": {
          "type": "array",
          "items": {"type": "string"}
        },
        "compile_commands": {
          "type": "array",
          "items": {"type": "string"}
        },
        "link_commands": {
          "type": "array",
          "items": {"type": "string"}
        }
      }
    },
    "dataset": {"$ref": "common.schema.json#/$defs/datasetIdentity"},
    "parameters": {"type": "object"},
    "resource_budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["memory_budget_bytes", "thread_budget"],
      "properties": {
        "memory_budget_bytes": {"type": "integer", "minimum": 1},
        "thread_budget": {"type": "integer", "minimum": 1, "maximum": 4294967295}
      }
    },
    "input_artifacts": {
      "type": "array",
      "items": {"$ref": "common.schema.json#/$defs/artifactRef"}
    },
    "output_artifacts": {
      "type": "array",
      "items": {"$ref": "common.schema.json#/$defs/artifactRef"}
    },
    "status": {"$ref": "common.schema.json#/$defs/stageStatus"},
    "started_at": {"type": "string", "format": "date-time"},
    "ended_at": {"type": "string", "format": "date-time"},
    "failure": {"$ref": "common.schema.json#/$defs/failure"},
    "reuse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reused", "reason"],
      "properties": {
        "reused": {"type": "boolean"},
        "reason": {"type": "string", "minLength": 1},
        "source_artifact": {"$ref": "common.schema.json#/$defs/artifactRef"}
      }
    },
    "validation_evidence_path": {"$ref": "common.schema.json#/$defs/relativePath"},
    "metrics": {"type": "object"}
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {"enum": ["FAILED", "INVALID_OUTPUT"]}
        }
      },
      "then": {"required": ["failure"]}
    }
  ]
}
