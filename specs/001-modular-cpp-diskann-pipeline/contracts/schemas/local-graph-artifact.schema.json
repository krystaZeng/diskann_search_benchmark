{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://diskann-repro.local/contracts/v1/local-graph-artifact.schema.json",
  "title": "LocalGraphArtifact Metadata v1",
  "description": "Local graph for one explicit owning PartitionId selected from an aggregate PartitionArtifact.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "canonicalization",
    "artifact_type",
    "format_version",
    "dataset",
    "id_space",
    "structural",
    "capabilities",
    "source_artifacts",
    "payloads",
    "aggregate_checksum"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "canonicalization": {"const": "diskann-artifact-c14n-v1"},
    "artifact_type": {"const": "local_graph"},
    "format_version": {"const": "local-graph-artifact/v1"},
    "dataset": {"$ref": "common.schema.json#/$defs/datasetIdentity"},
    "id_space": {"const": "local"},
    "structural": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "partition_id",
        "local_node_count",
        "declared_max_degree",
        "observed_max_degree",
        "source_partition_checksum"
      ],
      "properties": {
        "partition_id": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295,
          "description": "Mandatory owning PartitionId; must match a record in the source aggregate PartitionArtifact."
        },
        "local_node_count": {"type": "integer", "minimum": 1, "maximum": 4294967296},
        "declared_max_degree": {"type": "integer", "minimum": 0, "maximum": 4294967295},
        "observed_max_degree": {"type": "integer", "minimum": 0, "maximum": 4294967295},
        "source_partition_checksum": {
          "$ref": "common.schema.json#/$defs/sha256",
          "description": "Aggregate checksum of the exact aggregate PartitionArtifact supplied to Local Build."
        }
      }
    },
    "capabilities": {"$ref": "common.schema.json#/$defs/capabilityArray"},
    "source_artifacts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {"$ref": "common.schema.json#/$defs/sourceArtifactIdentity"}
    },
    "payloads": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [
        {
          "allOf": [
            {"$ref": "common.schema.json#/$defs/payloadRef"},
            {"type": "object", "properties": {"role": {"const": "local_to_global_map"}}}
          ]
        },
        {
          "allOf": [
            {"$ref": "common.schema.json#/$defs/payloadRef"},
            {"type": "object", "properties": {"role": {"const": "local_graph"}}}
          ]
        }
      ]
    },
    "aggregate_checksum": {"$ref": "common.schema.json#/$defs/sha256"}
  }
}
