{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://diskann-repro.local/specs/005/pq-artifact.schema.json",
  "title": "PQArtifact Metadata v1 design",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "canonicalization", "artifact_type", "format_version", "dataset",
    "id_space", "structural", "capabilities", "source_artifacts", "payloads",
    "aggregate_checksum"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "canonicalization": {"const": "diskann-artifact-c14n-v1"},
    "artifact_type": {"const": "pq"},
    "format_version": {"const": "pq-artifact/v1"},
    "dataset": {"$ref": "https://diskann-repro.local/contracts/v1/common.schema.json#/$defs/datasetIdentity"},
    "id_space": {"const": "none"},
    "structural": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "point_count", "dimension", "scalar_type", "distance_metric", "centroid_count",
        "pq_chunks", "opq", "compressed_code_scalar"
      ],
      "properties": {
        "point_count": {"type": "integer", "minimum": 1, "maximum": 4294967296},
        "dimension": {"type": "integer", "minimum": 1},
        "scalar_type": {"const": "float32"},
        "distance_metric": {"const": "l2"},
        "centroid_count": {"const": 256},
        "pq_chunks": {"type": "integer", "minimum": 1, "maximum": 512},
        "opq": {"const": false},
        "compressed_code_scalar": {"const": "uint8"}
      }
    },
    "capabilities": {
      "type": "array",
      "uniqueItems": true,
      "minItems": 2,
      "items": {"type": "string"},
      "allOf": [
        {"contains": {"const": "search.pq_in_memory/v1"}},
        {"contains": {"const": "search.pqflash_loadable/v1"}}
      ]
    },
    "source_artifacts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "prefixItems": [{
        "allOf": [
          {"$ref": "https://diskann-repro.local/contracts/v1/common.schema.json#/$defs/sourceArtifactIdentity"},
          {"type": "object", "properties": {"artifact_type": {"const": "dataset"}}}
        ]
      }]
    },
    "payloads": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [
        {
          "allOf": [
            {"$ref": "https://diskann-repro.local/contracts/v1/common.schema.json#/$defs/payloadRef"},
            {"type": "object", "properties": {
              "role": {"const": "pq_pivots"},
              "media_type": {"const": "application/vnd.diskann.pq-pivots+binary;version=1"}
            }}
          ]
        },
        {
          "allOf": [
            {"$ref": "https://diskann-repro.local/contracts/v1/common.schema.json#/$defs/payloadRef"},
            {"type": "object", "properties": {
              "role": {"const": "pq_compressed_vectors"},
              "media_type": {"const": "application/vnd.diskann.pq-codes+binary;version=1"}
            }}
          ]
        }
      ]
    },
    "aggregate_checksum": {"pattern": "^[0-9a-f]{64}$"}
  }
}

