{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://diskann-repro.local/specs/005/search-protocol.schema.json",
  "title": "Feature 005 SearchProtocol v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version", "protocol_id", "status", "search_execution",
    "search_execution_checksum", "evaluation", "canonicalization", "protocol_checksum"
  ],
  "properties": {
    "protocol_version": {"enum": ["1.0.0", "1.1.0"]},
    "protocol_id": {"$ref": "#/$defs/stableId"},
    "status": {"const": "frozen"},
    "search_execution": {"$ref": "#/$defs/searchExecution"},
    "search_execution_checksum": {"$ref": "#/$defs/sha256"},
    "evaluation": {"$ref": "#/$defs/evaluation"},
    "canonicalization": {"const": "diskann-search-protocol-c14n-v1"},
    "protocol_checksum": {"$ref": "#/$defs/sha256"}
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "protocol_version": {
            "const": "1.0.0"
          }
        }
      },
      "then": {
        "properties": {
          "evaluation": {
            "properties": {
              "evaluator": {
                "const": {
                  "implementation_id": "cpp_main_search_metrics_evaluator_v1",
                  "version": "1.0.0",
                  "reproduction_mode": "instrumented"
                }
              },
              "performance_eligibility_policy": {
                "const": "complete_valid_normative_environment_timing_parity_v1"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "protocol_version": {
            "const": "1.1.0"
          }
        }
      },
      "then": {
        "properties": {
          "evaluation": {
            "properties": {
              "evaluator": {
                "const": {
                  "implementation_id": "cpp_main_search_metrics_evaluator_v2",
                  "version": "2.0.0",
                  "reproduction_mode": "instrumented"
                }
              },
              "performance_eligibility_policy": {
                "const": "complete_valid_measurement_single_invocation_v2"
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "stableId": {"type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/+-]*$"},
    "relativePath": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
    "artifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metadata_path", "artifact_type", "format_version", "aggregate_checksum"],
      "properties": {
        "metadata_path": {"$ref": "#/$defs/relativePath"},
        "artifact_type": {"enum": ["dataset", "partition", "local_graph", "global_graph", "pq", "disk_layout"]},
        "format_version": {"type": "string", "minLength": 1},
        "aggregate_checksum": {"$ref": "#/$defs/sha256"}
      }
    },
    "implementationIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["implementation_id", "version", "reproduction_mode"],
      "properties": {
        "implementation_id": {"$ref": "#/$defs/stableId"},
        "version": {"type": "string", "minLength": 1},
        "reproduction_mode": {"enum": ["upstream_faithful", "instrumented"]}
      }
    },
    "fileRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "format", "byte_length", "sha256"],
      "properties": {
        "path": {"$ref": "#/$defs/relativePath"},
        "format": {"type": "string", "minLength": 1},
        "byte_length": {"type": "integer", "minimum": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "querySetRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reference_version", "query_set_id", "logical_source", "source", "query_count",
        "dimension", "scalar_type", "query_identity", "source_query_id_semantics",
        "self_match_policy", "native_payload", "row_mapping", "conversion_manifest_path",
        "validation_evidence_path", "canonical_checksum"
      ],
      "properties": {
        "reference_version": {"const": "1.0.0"},
        "query_set_id": {"$ref": "#/$defs/stableId"},
        "logical_source": {"type": "string", "minLength": 1},
        "source": {"$ref": "#/$defs/fileRef"},
        "query_count": {"type": "integer", "minimum": 1},
        "dimension": {"type": "integer", "minimum": 1},
        "scalar_type": {"const": "float32"},
        "query_identity": {"const": "query_row_index"},
        "source_query_id_semantics": {"const": "opaque"},
        "self_match_policy": {"const": "no_id_based_exclusion"},
        "native_payload": {"$ref": "#/$defs/fileRef"},
        "row_mapping": {"$ref": "#/$defs/fileRef"},
        "conversion_manifest_path": {"$ref": "#/$defs/relativePath"},
        "validation_evidence_path": {"$ref": "#/$defs/relativePath"},
        "canonical_checksum": {"$ref": "#/$defs/sha256"}
      }
    },
    "groundTruthRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reference_version", "ground_truth_id", "payload", "query_count", "width",
        "id_space", "distance_metric", "dataset_artifact", "query_set_checksum",
        "self_match_policy", "rank_100_tie_group_closed", "generation_manifest_path",
        "validation_evidence_path", "canonical_checksum"
      ],
      "properties": {
        "reference_version": {"const": "1.0.0"},
        "ground_truth_id": {"$ref": "#/$defs/stableId"},
        "payload": {"$ref": "#/$defs/fileRef"},
        "query_count": {"type": "integer", "minimum": 1},
        "width": {"type": "integer", "minimum": 100},
        "id_space": {"const": "global"},
        "distance_metric": {"const": "l2_squared_float32"},
        "dataset_artifact": {"$ref": "#/$defs/artifactRef"},
        "query_set_checksum": {"$ref": "#/$defs/sha256"},
        "self_match_policy": {"const": "no_id_based_exclusion"},
        "rank_100_tie_group_closed": {"const": true},
        "generation_manifest_path": {"$ref": "#/$defs/relativePath"},
        "validation_evidence_path": {"$ref": "#/$defs/relativePath"},
        "canonical_checksum": {"$ref": "#/$defs/sha256"}
      }
    },
    "runnerBuild": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_repository", "project_branch", "project_commit", "project_dirty",
        "binary_path", "binary_sha256", "build_manifest_path", "build_manifest_sha256"
      ],
      "properties": {
        "project_repository": {"type": "string", "format": "uri", "pattern": "^https://"},
        "project_branch": {"type": "string", "minLength": 1},
        "project_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "project_dirty": {"const": false},
        "binary_path": {"$ref": "#/$defs/relativePath"},
        "binary_sha256": {"$ref": "#/$defs/sha256"},
        "build_manifest_path": {"$ref": "#/$defs/relativePath"},
        "build_manifest_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "admissionEvidenceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "expected_artifact"],
      "properties": {
        "path": {"$ref": "#/$defs/relativePath"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "expected_artifact": {"$ref": "#/$defs/artifactRef"}
      }
    },
    "searchAdmissionEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pq_artifact", "disk_layout_artifact"],
      "properties": {
        "pq_artifact": {"$ref": "#/$defs/admissionEvidenceRef"},
        "disk_layout_artifact": {"$ref": "#/$defs/admissionEvidenceRef"}
      }
    },
    "environmentRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os", "storage", "direct_io", "linux_aio", "remote_storage_allowed"],
      "properties": {
        "os": {"const": "linux"},
        "storage": {"const": "local_ssd"},
        "direct_io": {"const": "required_and_probed"},
        "linux_aio": {"const": "required_and_probed"},
        "remote_storage_allowed": {"const": false}
      }
    },
    "searchExecution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "execution_id", "dataset_artifact", "pq_artifact", "disk_layout_artifact",
        "global_graph_artifact", "query_set", "distance_metric", "K", "L_search",
        "beamwidth", "thread_count", "cache", "io_limit", "warmup_policy", "query_order",
        "timing_boundary", "storage_placement", "repetition_count", "schedule",
        "entry_policy", "environment", "implementation", "runner_build",
        "diskann_source_commit"
      ],
      "properties": {
        "execution_id": {"$ref": "#/$defs/stableId"},
        "dataset_artifact": {"$ref": "#/$defs/artifactRef"},
        "pq_artifact": {"$ref": "#/$defs/artifactRef"},
        "disk_layout_artifact": {"$ref": "#/$defs/artifactRef"},
        "global_graph_artifact": {"$ref": "#/$defs/artifactRef"},
        "query_set": {"$ref": "#/$defs/querySetRef"},
        "distance_metric": {"const": "l2"},
        "K": {"const": 100},
        "L_search": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"type": "integer", "minimum": 100}
        },
        "beamwidth": {"const": 2},
        "thread_count": {"const": 6},
        "cache": {
          "oneOf": [
            {
              "type": "object", "additionalProperties": false,
              "required": ["mode", "requested_nodes"],
              "properties": {
                "mode": {"const": "zero"},
                "requested_nodes": {"const": 0}
              }
            },
            {
              "type": "object", "additionalProperties": false,
              "required": ["mode", "requested_nodes", "construction", "shuffle"],
              "properties": {
                "mode": {"const": "fixed_bfs"}, "requested_nodes": {"const": 10000},
                "construction": {"const": "medoid_bfs"}, "shuffle": {"const": false}
              }
            }
          ]
        },
        "io_limit": {"const": 4294967295},
        "warmup_policy": {"const": "none"},
        "query_order": {"const": "query_row_index_ascending"},
        "timing_boundary": {"const": "cpp_main_search_disk_index_query_batch_v1"},
        "storage_placement": {"type": "string", "minLength": 1},
        "repetition_count": {"const": 3},
        "schedule": {"const": "repetition_major_then_L_order"},
        "entry_policy": {"const": "end_to_end"},
        "environment": {"$ref": "#/$defs/environmentRequirement"},
        "implementation": {"$ref": "#/$defs/implementationIdentity"},
        "runner_build": {"$ref": "#/$defs/runnerBuild"},
        "admission_evidence": {"$ref": "#/$defs/searchAdmissionEvidence"},
        "diskann_source_commit": {"const": "78256bbab4685e1774e78d331e081a153be26823"}
      }
    },
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ground_truth", "evaluator", "metrics", "quality_eligibility_policy",
        "performance_eligibility_policy",
        "aggregation_policy", "replacement_repetitions"
      ],
      "properties": {
        "ground_truth": {"$ref": "#/$defs/groundTruthRef"},
        "evaluator": {"$ref": "#/$defs/implementationIdentity"},
        "metrics": {
          "const": [
            "recall_at_10", "recall_at_100", "qps_k100", "mean_latency_us_k100",
            "p99_9_latency_us_k100", "mean_ios_k100"
          ]
        },
        "quality_eligibility_policy": {
          "const": "complete_valid_ground_truth_identity_search_semantics_v1"
        },
        "performance_eligibility_policy": {
          "enum": ["complete_valid_normative_environment_timing_parity_v1", "complete_valid_measurement_single_invocation_v2"]
        },
        "aggregation_policy": {"const": "median_eligible"},
        "replacement_repetitions": {"const": false}
      }
    }
  }
}
