if(NOT DEFINED ASSEMBLY_FILE OR NOT EXISTS "${ASSEMBLY_FILE}")
  message(FATAL_ERROR "assembly target evidence file is missing")
endif()
file(READ "${ASSEMBLY_FILE}" assembly)
if(assembly MATCHES "production_links=[^\n]*fake")
  message(FATAL_ERROR "production runner links a Fake target")
endif()
if(assembly MATCHES "production_sources=[^\n]*fake")
  message(FATAL_ERROR "production runner includes Fake registration/source")
endif()
if(NOT assembly MATCHES "fake_target=diskann_pipeline_fake_runner")
  message(FATAL_ERROR "Fake runner is not an independent target")
endif()
