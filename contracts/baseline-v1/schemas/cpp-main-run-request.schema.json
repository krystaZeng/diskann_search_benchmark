    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workspace", "runner", "report"],
      "properties": {
        "workspace": {"const": "build/cpp-main-baseline/runs/sift1m-unified"},
        "runner": {"const": "build/cpp-main-baseline/src/baseline/cpp_main/cpp_main_baseline_runner"},
        "report": {"const": "specs/002-cpp-main-upstream-baseline/unified-sharded-report.json"}
