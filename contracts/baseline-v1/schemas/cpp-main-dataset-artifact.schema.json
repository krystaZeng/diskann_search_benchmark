{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://diskann-repro.local/contracts/baseline-v1/cpp-main-dataset-artifact.schema.json",
  "title": "cpp_main float32 DatasetArtifact metadata",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "canonicalization", "artifact_type", "format_version", "dataset", "id_space", "structural", "capabilities", "source_artifacts", "payloads", "aggregate_checksum"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "canonicalization": {"const": "diskann-artifact-c14n-v1"},
    "artifact_type": {"const": "dataset"},
    "format_version": {"const": "diskann-float32-dataset/v1"},
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dataset_id", "dataset_checksum", "global_node_count", "vector_dimension", "scalar_type", "distance_metric"],
      "properties": {
        "dataset_id": {"type": "string", "minLength": 1},
        "dataset_checksum": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "global_node_count": {"type": "integer", "minimum": 1, "maximum": 4294967296},
        "vector_dimension": {"type": "integer", "minimum": 1, "maximum": 4294967295},
        "scalar_type": {"const": "float32"},
        "distance_metric": {"const": "l2"}
      }
    },
    "id_space": {"const": "none"},
    "structural": {
      "type": "object",
      "additionalProperties": false,
      "required": ["global_node_count", "vector_dimension", "scalar_type", "distance_metric"],
      "properties": {
        "global_node_count": {"type": "integer", "minimum": 1, "maximum": 4294967296},
        "vector_dimension": {"type": "integer", "minimum": 1, "maximum": 4294967295},
        "scalar_type": {"const": "float32"},
        "distance_metric": {"const": "l2"}
      }
    },
    "capabilities": {
      "type": "array",
      "contains": {"const": "dataset.diskann_float32_bin/v1"},
      "minContains": 1
    },
    "source_artifacts": {"type": "array", "maxItems": 0},
    "payloads": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "path", "media_type", "byte_length", "sha256"],
        "properties": {
          "role": {"const": "vectors"},
          "path": {"type": "string", "minLength": 1},
          "media_type": {"const": "application/vnd.diskann.cpp-main.float32-bin;version=1"},
          "byte_length": {"type": "integer", "minimum": 12},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "aggregate_checksum": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
