{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://diskann-repro.local/contracts/v1/global-graph-artifact.schema.json",
  "title": "GlobalGraphArtifact Metadata v1",
  "description": "A required global graph payload plus an optional medoids payload. Implementations that declare graph.medoids/v1 must produce medoids.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "canonicalization",
    "artifact_type",
    "format_version",
    "dataset",
    "id_space",
    "structural",
    "capabilities",
    "source_artifacts",
    "payloads",
    "aggregate_checksum"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "canonicalization": {"const": "diskann-artifact-c14n-v1"},
    "artifact_type": {"const": "global_graph"},
    "format_version": {"const": "global-graph-artifact/v1"},
    "dataset": {"$ref": "common.schema.json#/$defs/datasetIdentity"},
    "id_space": {"const": "global"},
    "structural": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "global_node_count",
        "declared_max_degree",
        "observed_max_degree",
        "source_partition_artifact",
        "source_local_graph_artifacts"
      ],
      "properties": {
        "global_node_count": {"type": "integer", "minimum": 1, "maximum": 4294967296},
        "declared_max_degree": {"type": "integer", "minimum": 0, "maximum": 4294967295},
        "observed_max_degree": {"type": "integer", "minimum": 0, "maximum": 4294967295},
        "source_partition_artifact": {
          "$ref": "common.schema.json#/$defs/sourceArtifactIdentity"
        },
        "source_local_graph_artifacts": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "common.schema.json#/$defs/sourceArtifactIdentity"}
        }
      }
    },
    "capabilities": {"$ref": "common.schema.json#/$defs/capabilityArray"},
    "source_artifacts": {
      "type": "array",
      "minItems": 2,
      "items": {"$ref": "common.schema.json#/$defs/sourceArtifactIdentity"}
    },
    "payloads": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "prefixItems": [
        {
          "allOf": [
            {"$ref": "common.schema.json#/$defs/payloadRef"},
            {"type": "object", "properties": {"role": {"const": "global_graph"}}}
          ]
        },
        {
          "allOf": [
            {"$ref": "common.schema.json#/$defs/payloadRef"},
            {"type": "object", "properties": {"role": {"const": "medoids"}}}
          ]
        }
      ]
    },
    "aggregate_checksum": {"$ref": "common.schema.json#/$defs/sha256"}
  }
}
