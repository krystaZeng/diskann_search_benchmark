{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://diskann-repro.local/contracts/v1/validation-evidence.schema.json",
  "title": "ValidationEvidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["evidence_version", "validator_version", "artifact_candidate", "checks", "result"],
  "properties": {
    "evidence_version": {"const": "1.0.0"},
    "validator_version": {"$ref": "common.schema.json#/$defs/version"},
    "artifact_candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_type", "format_version", "metadata_path"],
      "properties": {
        "artifact_type": {"$ref": "common.schema.json#/$defs/artifactType"},
        "format_version": {"$ref": "common.schema.json#/$defs/version"},
        "metadata_path": {"$ref": "common.schema.json#/$defs/relativePath"},
        "claimed_aggregate_checksum": {"$ref": "common.schema.json#/$defs/sha256"}
      }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["check_id", "passed", "message"],
        "properties": {
          "check_id": {"$ref": "common.schema.json#/$defs/stableId"},
          "passed": {"type": "boolean"},
          "expected": true,
          "observed": true,
          "message": {"type": "string", "minLength": 1}
        }
      }
    },
    "result": {"enum": ["VALID", "INVALID"]},
    "failure_category": {"$ref": "common.schema.json#/$defs/stableId"}
  },
  "allOf": [
    {
      "if": {"properties": {"result": {"const": "INVALID"}}},
      "then": {"required": ["failure_category"]}
    }
  ]
}
