{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://diskann-repro.local/contracts/partition/diskann-kmeans-v1/parameters.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["K"],
